# Copy to .env (never commit it) or export these in your shell / hosting platform.
# LLM provider keys. Set ONE OR MORE; pick the active provider in Settings > Connections (or NEXUSML_LLM_PROVIDER / --provider).
# Keys are read ONLY from environment variables and are never stored, logged, or shown by the app. Never commit a real key.
GEMINI_API_KEY=          # Google AI Studio key (https://aistudio.google.com/apikey)
GROQ_API_KEY=            # Groq key (https://console.groq.com/keys)
# OPENAI_API_KEY=        # optional extra providers (OpenAI-compatible)
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# NEXUSML_LLM_PROVIDER=groq   # groq | gemini | openai | openrouter | together (default: gemini if its key is set, else the first provider with a key)
# NEXUSML_EXTRA_PROVIDERS=[{"id":"x","name":"X","base_url":"https://example.com/v1","api_key_env":"X_API_KEY","model":"m"}]   # more providers; only the variable NAME goes here
# NEXUSML_LLM_MODEL=gemini-3.1-flash-lite   # any model id your key can use (flash-lite = lowest cost)
# NEXUSML_LLM_MODEL=openai/gpt-oss-120b
# NEXUSML_TUNE_ITER=12
# NEXUSML_SEND_SAMPLES=0     # 1 = also send a few raw example values per column to the LLM

# Optional Power BI push (leave unset to only write the offline package)
# POWERBI_PUSH_URL=                        # streaming/push dataset URL, key included
# POWERBI_DATASET_ID=
# POWERBI_ACCESS_TOKEN=

# Optional web context for root-cause analysis (Tavily free tier: 1,000 credits/month)
TAVILY_API_KEY=
# Optional: real MLflow store to mirror runs to (default: ./mlruns under the artifact folder)
# MLFLOW_TRACKING_URI=

# Data from links (Kaggle needs a login even for public datasets). Create a token at https://www.kaggle.com/settings
KAGGLE_API_TOKEN=                    # the newer single access token (starts with KGAT_); no quotes
# KAGGLE_USERNAME=                   # or the classic pair
# KAGGLE_KEY=
# NEXUSML_MAX_DOWNLOAD_MB=100        # largest download accepted from a link
